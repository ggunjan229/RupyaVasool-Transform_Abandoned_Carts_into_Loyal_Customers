# Optional. Without a key, the worker uses deterministic fallback messages.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional local settings
DATABASE_URL=sqlite:///./revenue_recovery.db
ENV=development
DEBUG=true
ABANDONMENT_GRACE_SECONDS=60
STEP_INTERVAL_SECONDS=60
DND_TIMEZONE=Asia/Kolkata
